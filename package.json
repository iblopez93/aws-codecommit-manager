{
	"name": "aws-codecommit-manager",
	"displayName": "AWS CodeCommit Manager",
	"description": "Manage info, actions and tasks about code in AWS CodeCommit",
	"version": "0.0.1",
	"publisher": "aws-codecommit-manager",
	"engines": {
		"vscode": "^1.136.0"
	},
	"categories": [
		"Source Control",
		"Other"
	],
	"activationEvents": [
		"onView:aws-codecommit-manager.view"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"views": {
			"explorer": [
				{
					"id": "aws-codecommit-manager.view",
					"name": "AWS CodeCommit"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "aws-codecommit-manager.view",
				"contents": "AWS CodeCommit repositories will appear here.\n[Login](command:aws-codecommit-manager.login)\n[Configure AWS CodeCommit](command:aws-codecommit-manager.configure)\n[Show Logs](command:aws-codecommit-manager.showLogs)\n[Getting Started Walkthrough](command:workbench.action.openWalkthrough?%22aws-codecommit-manager.gettingStarted%22)\n[Refresh](command:aws-codecommit-manager.refresh)"
			}
		],
		"walkthroughs": [
			{
				"id": "aws-codecommit-manager.gettingStarted",
				"title": "Getting Started with AWS CodeCommit",
				"description": "Configure your AWS connection, log in with SSO, and make your first commit and pull request.",
				"steps": [
					{
						"id": "configure",
						"title": "Configure the AWS connection",
						"description": "Set the region and profile used to reach AWS.\n[Configure Connection](command:aws-codecommit-manager.configure)",
						"completionEvents": ["onCommand:aws-codecommit-manager.configure"],
						"media": { "markdown": "walkthroughs/getting-started.md" }
					},
					{
						"id": "login",
						"title": "Log in with AWS SSO",
						"description": "Start the interactive SSO device login.\n[Start SSO Login](command:aws-codecommit-manager.login)",
						"completionEvents": ["onCommand:aws-codecommit-manager.login"],
						"media": { "markdown": "walkthroughs/getting-started.md" }
					},
					{
						"id": "browse",
						"title": "Browse repositories and files",
						"description": "Open the AWS CodeCommit view and explore repositories, branches, and files.\n[Refresh the View](command:aws-codecommit-manager.refresh)",
						"completionEvents": ["onCommand:aws-codecommit-manager.openFile"],
						"media": { "markdown": "walkthroughs/getting-started.md" }
					},
					{
						"id": "commit",
						"title": "Create your first commit",
						"description": "Upload a file or create an atomic commit on a branch.\n[Upload File](command:aws-codecommit-manager.putFile)",
						"completionEvents": ["onCommand:aws-codecommit-manager.putFile", "onCommand:aws-codecommit-manager.createCommit"],
						"media": { "markdown": "walkthroughs/getting-started.md" }
					},
					{
						"id": "pull-request",
						"title": "Create a pull request",
						"description": "Open a pull request between branches and review the changes.\n[Create Pull Request](command:aws-codecommit-manager.createPullRequest)",
						"completionEvents": ["onCommand:aws-codecommit-manager.createPullRequest"],
						"media": { "markdown": "walkthroughs/getting-started.md" }
					}
				]
			}
		],
		"commands": [
			{
				"command": "aws-codecommit-manager.configure",
				"title": "Configure AWS CodeCommit",
				"category": "AWS CodeCommit",
				"icon": "$(gear)"
			},
			{
				"command": "aws-codecommit-manager.login",
				"title": "Login",
				"category": "AWS CodeCommit",
				"icon": "$(plug)"
			},
			{
				"command": "aws-codecommit-manager.refresh",
				"title": "Refresh",
				"category": "AWS CodeCommit",
				"icon": "$(refresh)"
			},
			{
				"command": "aws-codecommit-manager.openFile",
				"title": "Open Remote File",
				"category": "AWS CodeCommit",
				"icon": "$(open-preview)"
			},
			{
				"command": "aws-codecommit-manager.saveRemoteFile",
				"title": "Save to CodeCommit",
				"category": "AWS CodeCommit",
				"icon": "$(save)"
			},
			{
				"command": "aws-codecommit-manager.compareWithLocal",
				"title": "Compare Remote File with Local File",
				"category": "AWS CodeCommit"
			},
			{
				"command": "aws-codecommit-manager.compareAcrossBranches",
				"title": "Compare File Across Branches",
				"category": "AWS CodeCommit"
			},
			{
				"command": "aws-codecommit-manager.openInCodeCommit",
				"title": "Open Current File in CodeCommit",
				"category": "AWS CodeCommit"
			},
			{
				"command": "aws-codecommit-manager.compareWithCodeCommit",
				"title": "Compare with CodeCommit",
				"category": "AWS CodeCommit"
			},
			{
				"command": "aws-codecommit-manager.createRepository",
				"title": "Create Repository",
				"category": "AWS CodeCommit",
				"icon": "$(add)"
			},
			{
				"command": "aws-codecommit-manager.deleteRepository",
				"title": "Delete Repository",
				"category": "AWS CodeCommit",
				"icon": "$(trash)"
			},
			{
				"command": "aws-codecommit-manager.copyCloneUrlHttps",
				"title": "Copy Clone URL (HTTPS)",
				"category": "AWS CodeCommit",
				"icon": "$(copy)"
			},
			{
				"command": "aws-codecommit-manager.copyCloneUrlGrc",
				"title": "Copy Clone URL (GRC)",
				"category": "AWS CodeCommit",
				"icon": "$(copy)"
			},
			{
				"command": "aws-codecommit-manager.openRepository",
				"title": "Open in AWS Console",
				"category": "AWS CodeCommit",
				"icon": "$(globe)"
			},
			{
				"command": "aws-codecommit-manager.repositoryDetails",
				"title": "Repository Details",
				"category": "AWS CodeCommit",
				"icon": "$(info)"
			},
			{
				"command": "aws-codecommit-manager.createBranch",
				"title": "Create Branch",
				"category": "AWS CodeCommit",
				"icon": "$(git-branch)"
			},
			{
				"command": "aws-codecommit-manager.deleteBranch",
				"title": "Delete Branch",
				"category": "AWS CodeCommit",
				"icon": "$(trash)"
			},
			{
				"command": "aws-codecommit-manager.setDefaultBranch",
				"title": "Set as Default Branch",
				"category": "AWS CodeCommit"
			},
			{
				"command": "aws-codecommit-manager.putFile",
				"title": "Upload File",
				"category": "AWS CodeCommit",
				"icon": "$(cloud-upload)"
			},
			{
				"command": "aws-codecommit-manager.deleteFile",
				"title": "Delete Remote File",
				"category": "AWS CodeCommit",
				"icon": "$(trash)"
			},
			{
				"command": "aws-codecommit-manager.createCommit",
				"title": "Create Commit from Local Files",
				"category": "AWS CodeCommit",
				"icon": "$(git-commit)"
			},
			{
				"command": "aws-codecommit-manager.createPullRequest",
				"title": "Create Pull Request",
				"category": "AWS CodeCommit",
				"icon": "$(git-pull-request)"
			},
			{
				"command": "aws-codecommit-manager.updatePullRequestTitle",
				"title": "Update Pull Request Title",
				"category": "AWS CodeCommit"
			},
			{
				"command": "aws-codecommit-manager.updatePullRequestDescription",
				"title": "Update Pull Request Description",
				"category": "AWS CodeCommit"
			},
			{
				"command": "aws-codecommit-manager.publishPullRequest",
				"title": "Open / Publish Pull Request",
				"category": "AWS CodeCommit",
				"icon": "$(check)"
			},
			{
				"command": "aws-codecommit-manager.closePullRequest",
				"title": "Close Pull Request",
				"category": "AWS CodeCommit",
				"icon": "$(close)"
			},
			{
				"command": "aws-codecommit-manager.showPullRequestReview",
				"title": "Show Pull Request Review",
				"category": "AWS CodeCommit"
			},
			{
				"command": "aws-codecommit-manager.addPullRequestComment",
				"title": "Add Review Comment",
				"category": "AWS CodeCommit",
				"icon": "$(comment)"
			},
			{
				"command": "aws-codecommit-manager.loadMoreCommits",
				"title": "Load More Commits",
				"category": "AWS CodeCommit"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "aws-codecommit-manager.refresh",
					"when": "view == aws-codecommit-manager.view",
					"group": "navigation"
				},
				{
					"command": "aws-codecommit-manager.configure",
					"when": "view == aws-codecommit-manager.view",
					"group": "navigation@2"
				}
			],
			"view/item/context": [
				{
					"command": "aws-codecommit-manager.refresh",
					"when": "view == aws-codecommit-manager.view && viewItem == repository",
					"group": "inline"
				},
				{
					"command": "aws-codecommit-manager.repositoryDetails",
					"when": "view == aws-codecommit-manager.view && viewItem == repository",
					"group": "1_repository"
				},
				{
					"command": "aws-codecommit-manager.copyCloneUrlHttps",
					"when": "view == aws-codecommit-manager.view && viewItem == repository",
					"group": "1_repository"
				},
				{
					"command": "aws-codecommit-manager.copyCloneUrlGrc",
					"when": "view == aws-codecommit-manager.view && viewItem == repository",
					"group": "1_repository"
				},
				{
					"command": "aws-codecommit-manager.openRepository",
					"when": "view == aws-codecommit-manager.view && viewItem == repository",
					"group": "1_repository"
				},
				{
					"command": "aws-codecommit-manager.deleteRepository",
					"when": "view == aws-codecommit-manager.view && viewItem == repository",
					"group": "3_danger"
				},
				{
					"command": "aws-codecommit-manager.createBranch",
					"when": "view == aws-codecommit-manager.view && viewItem == repository",
					"group": "2_branches"
				},
				{
					"command": "aws-codecommit-manager.createPullRequest",
					"when": "view == aws-codecommit-manager.view && viewItem == repository",
					"group": "2_pullrequests"
				},
				{
					"command": "aws-codecommit-manager.createBranch",
					"when": "view == aws-codecommit-manager.view && viewItem == branchesGroup",
					"group": "1_branches"
				},
				{
					"command": "aws-codecommit-manager.refresh",
					"when": "view == aws-codecommit-manager.view && viewItem == branch",
					"group": "inline"
				},
				{
					"command": "aws-codecommit-manager.setDefaultBranch",
					"when": "view == aws-codecommit-manager.view && viewItem == branch",
					"group": "1_branches"
				},
				{
					"command": "aws-codecommit-manager.deleteBranch",
					"when": "view == aws-codecommit-manager.view && viewItem == branch",
					"group": "3_danger"
				},
				{
					"command": "aws-codecommit-manager.createPullRequest",
					"when": "view == aws-codecommit-manager.view && viewItem == branch",
					"group": "2_pullrequests"
				},
				{
					"command": "aws-codecommit-manager.putFile",
					"when": "view == aws-codecommit-manager.view && (viewItem == branch || viewItem == filesGroup || viewItem == folder)",
					"group": "1_files"
				},
				{
					"command": "aws-codecommit-manager.createCommit",
					"when": "view == aws-codecommit-manager.view && (viewItem == branch || viewItem == filesGroup || viewItem == folder)",
					"group": "2_commits"
				},
				{
					"command": "aws-codecommit-manager.openFile",
					"when": "view == aws-codecommit-manager.view && viewItem == file",
					"group": "inline"
				},
				{
					"command": "aws-codecommit-manager.compareWithLocal",
					"when": "view == aws-codecommit-manager.view && viewItem == file",
					"group": "2_compare"
				},
				{
					"command": "aws-codecommit-manager.compareAcrossBranches",
					"when": "view == aws-codecommit-manager.view && (viewItem == file || viewItem == branch)",
					"group": "2_compare"
				},
				{
					"command": "aws-codecommit-manager.deleteFile",
					"when": "view == aws-codecommit-manager.view && viewItem == file",
					"group": "3_danger"
				},
				{
					"command": "aws-codecommit-manager.createPullRequest",
					"when": "view == aws-codecommit-manager.view && viewItem == pullRequestsGroup",
					"group": "1_pullrequests"
				},
				{
					"command": "aws-codecommit-manager.refresh",
					"when": "view == aws-codecommit-manager.view && viewItem == pullRequestsGroup",
					"group": "navigation"
				},
				{
					"command": "aws-codecommit-manager.updatePullRequestTitle",
					"when": "view == aws-codecommit-manager.view && viewItem == pullRequest",
					"group": "1_pullrequests"
				},
				{
					"command": "aws-codecommit-manager.updatePullRequestDescription",
					"when": "view == aws-codecommit-manager.view && viewItem == pullRequest",
					"group": "1_pullrequests"
				},
				{
					"command": "aws-codecommit-manager.publishPullRequest",
					"when": "view == aws-codecommit-manager.view && viewItem == pullRequest",
					"group": "2_actions"
				},
				{
					"command": "aws-codecommit-manager.closePullRequest",
					"when": "view == aws-codecommit-manager.view && viewItem == pullRequest",
					"group": "3_danger"
				},
				{
					"command": "aws-codecommit-manager.showPullRequestReview",
					"when": "view == aws-codecommit-manager.view && viewItem == pullRequest",
					"group": "2_review"
				},
				{
					"command": "aws-codecommit-manager.addPullRequestComment",
					"when": "view == aws-codecommit-manager.view && (viewItem == pullRequest || viewItem == commentsGroup)",
					"group": "1_comments"
				},
				{
					"command": "aws-codecommit-manager.loadMoreCommits",
					"when": "view == aws-codecommit-manager.view && viewItem == loadMoreCommits",
					"group": "inline"
				}
			],
			"editor/context": [
				{
					"command": "aws-codecommit-manager.openInCodeCommit",
					"when": "resourceScheme == file",
					"group": "aws-codecommit@1"
				},
				{
					"command": "aws-codecommit-manager.compareWithCodeCommit",
					"when": "resourceScheme == file",
					"group": "aws-codecommit@2"
				}
			],
			"commandPalette": [
				{
					"command": "aws-codecommit-manager.openInCodeCommit",
					"when": "editorIsOpen"
				},
				{
					"command": "aws-codecommit-manager.compareWithCodeCommit",
					"when": "editorIsOpen"
				},
				{
					"command": "aws-codecommit-manager.saveRemoteFile",
					"when": "resourceScheme == codecommit-remote"
				},
				{
					"command": "aws-codecommit-manager.deleteRepository",
					"when": "false"
				},
				{
					"command": "aws-codecommit-manager.copyCloneUrlHttps",
					"when": "false"
				},
				{
					"command": "aws-codecommit-manager.copyCloneUrlGrc",
					"when": "false"
				},
				{
					"command": "aws-codecommit-manager.openRepository",
					"when": "false"
				},
				{
					"command": "aws-codecommit-manager.repositoryDetails",
					"when": "false"
				}
			]
		},
		"configuration": {
			"title": "AWS CodeCommit",
			"properties": {
				"aws-codecommit-manager.region": {
					"type": "string",
					"default": "",
					"markdownDescription": "AWS region used by CodeCommit, for example `us-east-1`. Leave empty to use the SDK default region resolution."
				},
				"aws-codecommit-manager.profile": {
					"type": "string",
					"default": "",
					"markdownDescription": "Named AWS profile from `~/.aws/credentials` or `~/.aws/config` used for credentials. Leave empty to use the default credential chain."
				},
				"aws-codecommit-manager.ssoProfile": {
					"type": "string",
					"default": "",
					"markdownDescription": "Named AWS profile configured with IAM Identity Center (SSO) credentials. When set, SSO credentials are used instead of the default credential chain."
				},
				"aws-codecommit-manager.commitHistoryLimit": {
					"type": "number",
					"default": 100,
					"minimum": 1,
					"maximum": 10000,
					"markdownDescription": "Maximum number of commits loaded when expanding a branch commit history."
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run package",
		"compile": "npm run check-types && npm run lint && node esbuild.js",
		"watch": "npm-run-all -p watch:*",
		"watch:esbuild": "node esbuild.js --watch",
		"watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
		"package": "npm run check-types && npm run lint && node esbuild.js --production",
		"compile-tests": "tsc -p . --outDir out",
		"watch-tests": "tsc -p . -w --outDir out",
		"pretest": "npm run compile-tests && npm run compile && npm run lint",
		"check-types": "tsc --noEmit",
		"lint": "eslint src",
		"test": "vscode-test"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "24.x",
		"@types/vscode": "^1.136.0",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^3.0.0",
		"esbuild": "^0.28.1",
		"eslint": "^10.5.0",
		"npm-run-all": "^4.1.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.61.1"
	},
	"overrides": {
		"diff": "^8.0.4",
		"serialize-javascript": "^7.0.6"
	},
	"dependencies": {
		"@aws-sdk/client-codecommit": "^3.1128.0",
		"@aws-sdk/client-sso": "^3.1128.0",
		"@aws-sdk/client-sso-oidc": "^3.1128.0",
		"@aws-sdk/credential-providers": "^3.1128.0"
	}
}
